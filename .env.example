AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_MODEL=gpt-5.4
AZURE_OPENAI_API_VERSION=preview

# --- Authentication (Microsoft Entra ID) ---
# The credential is selected by priority:
#   1. Service principal  - when SP_AZURE_CLIENT_SECRET (+ client id) is set
#   2. Managed identity   - when MI_AZURE_CLIENT_ID is set
#   3. DefaultAzureCredential (for example, the local `az login`) otherwise
# Keep real secrets only in .env (gitignored), never in this example file.
#
# Service principal (workload identity). Recommended for dev containers behind
# device-compliance Conditional Access, since it is not subject to user device
# policies. Grant the SP the "Cognitive Services OpenAI User" role on the Azure
# OpenAI resource. SP_AZURE_TENANT_ID falls back to MI_AZURE_TENANT_ID.
# SP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# SP_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SP_AZURE_CLIENT_SECRET=your-client-secret
#
# User-assigned managed identity (Azure-hosted only). Set the client id and the
# tenant the service principal shares:
# MI_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# MI_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
